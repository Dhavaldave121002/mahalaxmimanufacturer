# ==============================================================================
# MAHALAXMI ENTERPRISES - PRODUCTION ENVIRONMENT CONFIGURATION
# Fill these values when deploying to Vercel, cPanel, Hostinger, VPS, or AWS
# ==============================================================================

# 1. MySQL Production Database Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mahalaxmi_db
MYSQL_SSL=false

# OR using a single Database URL (e.g. from PlanetScale, Railway, AWS, DigitalOcean)
# DATABASE_URL=mysql://user:password@host:3306/mahalaxmi_db?sslaccept=strict

# 2. Public API Base URL (Used by Website & Mobile App)
VITE_API_URL=https://mahalaxmimanufacturer.vercel.app/api

# 3. OTP & Transactional Email Service (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here

# 4. App Store & Play Store Production Settings
APP_PACKAGE_NAME=com.mahalaxmi.enterprises
IOS_BUNDLE_IDENTIFIER=com.mahalaxmi.enterprises
